# Required — generate with: openssl rand -base64 48
SESSION_SECRET=

# Required in production (enables Secure cookies and stricter defaults)
NODE_ENV=development

# Listen address (default 127.0.0.1:8787 — bind 0.0.0.0 behind a reverse proxy in prod)
HOST=127.0.0.1
PORT=8787

# Set to 1 when behind TLS-terminating proxy (Fly, Render, nginx)
TRUST_PROXY=0

# Optional — default admin username for bootstrap (default: admin)
# ADMIN_USERNAME=admin

# SQLite database directory (default: ./data relative to admin-portal/)
# ADMIN_DATA_DIR=./data

# Session lifetime in seconds (default: 28800 = 8 hours)
# SESSION_MAX_AGE_SEC=28800
