{
  "name": "@partsharbor/admin-portal",
  "version": "2.0.0",
  "private": true,
  "description": "PartsHarbor admin portal on Cloudflare Workers + D1",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "bootstrap-admin": "node scripts/bootstrap-admin.js",
    "bootstrap-admin:remote": "node scripts/bootstrap-admin.js --remote",
    "db:migrate:local": "wrangler d1 migrations apply partsharbor-admin --local",
    "db:migrate:remote": "bash scripts/d1-migrate-remote.sh",
    "test:push-social-feed": "bash scripts/test-push-social-feed-dry-run.sh"
  },
  "dependencies": {
    "argon2id": "^1.0.1",
    "hono": "^4.7.4"
  },
  "devDependencies": {
    "argon2": "^0.41.1",
    "wrangler": "^4.0.0"
  }
}
