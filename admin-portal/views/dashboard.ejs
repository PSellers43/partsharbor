<%- include('partials/layout-top') %>
<header class="admin-header">
  <div class="brand">PartsHarbor <span>Admin</span></div>
  <form method="post" action="/admin/logout">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <button type="submit" class="btn btn-ghost">Log out</button>
  </form>
</header>
<main class="admin-main">
  <div class="card">
    <h1>Welcome</h1>
    <p class="subtitle">You are signed in to the PartsHarbor admin portal. Additional tools can be mounted here behind the same session.</p>
    <ul class="meta-list">
      <li><span class="label">Signed in as</span><span><%= sessionMeta.username %></span></li>
      <li><span class="label">Session</span><span><%= sessionMeta.sessionId %></span></li>
      <% if (sessionMeta.expires) { %>
        <li><span class="label">Cookie expires (UTC)</span><span><%= new Date(sessionMeta.expires).toISOString() %></span></li>
      <% } %>
    </ul>
  </div>
</main>
<%- include('partials/layout-bottom') %>
